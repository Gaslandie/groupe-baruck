# Site public Groupe Baruck : export statique Next.js servi par Apache (Bluehost).
# Copié dans la racine du site par deploy/bluehost.sh, qui remplace __SITE_DOMAIN__.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
RewriteEngine On
# >>> https — retiré par le script tant que le certificat du domaine n'est pas actif.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://__SITE_DOMAIN__%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.__SITE_DOMAIN_RE__$ [NC]
RewriteRule ^ https://__SITE_DOMAIN__%{REQUEST_URI} [R=301,L]
# <<< https
</IfModule>

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# Les fichiers de _next/static portent une empreinte dans leur nom : cache long.
<If "%{REQUEST_URI} =~ m#^/_next/static/#">
Header set Cache-Control "public, max-age=31536000, immutable"
</If>
</IfModule>

<IfModule mod_expires.c>
ExpiresActive On
ExpiresDefault "access plus 1 hour"
ExpiresByType text/html "access plus 0 seconds"
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
