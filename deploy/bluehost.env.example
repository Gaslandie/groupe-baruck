# Copier en deploy/bluehost.env (ignoré par Git) et compléter.

# Accès SSH au compte cPanel Bluehost : activer « SSH Access » dans cPanel, puis
# importer et autoriser la clé publique de la machine qui déploie (~/.ssh/id_ed25519.pub).
BLUEHOST_SSH=utilisateur@groupebaruck.com
BLUEHOST_PORT=22

SITE_DOMAIN=groupebaruck.com
ADMIN_DOMAIN=admin.groupebaruck.com

# Document Root de groupebaruck.com, tel que cPanel l'affiche (« npm run deploy -- check » le lit).
# Jamais le public_html commun aux autres sites du compte.
SITE_ROOT=

# Dossier privé du back-office, relatif au dossier personnel du compte ; le sous-domaine
# d'administration pointe sur ADMIN_DIR/public uniquement.
ADMIN_DIR=baruck-admin

# PHP en ligne de commande sur le serveur (8.2 minimum). Si « php » est trop ancien,
# indiquer par exemple /opt/cpanel/ea-php82/root/usr/bin/php (« check » liste les versions).
REMOTE_PHP=php

# Facultatif : clé Web3Forms du formulaire de contact (repli mailto: si vide).
NEXT_PUBLIC_WEB3FORMS_KEY=
# Facultatif : point de collecte d'audience. Vide = déduit de ADMIN_DOMAIN ; « off » = désactivé.
AUDIENCE_URL=
